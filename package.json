{
  "name": "brainy-bits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Five small Vietnamese brain-training games in one static page.",
  "scripts": {
    "parity": "node scripts/parity-check.mjs",
    "test": "playwright test",
    "test:sim": "node --test scripts/sim/difficulty.test.mjs",
    "test:install": "node --test scripts/install-platform.test.mjs",
    "sim": "node scripts/sim/calibrate.mjs",
    "sim:train": "node scripts/sim/calibrate.mjs train --n 1200",
    "sim:koi": "node scripts/sim/calibrate.mjs koi --n 2000",
    "sim:mem": "node scripts/sim/calibrate.mjs mem --n 1200",
    "sim:rain": "node scripts/sim/calibrate.mjs rain --n 1200",
    "sim:word": "node scripts/sim/calibrate.mjs word --n 1200",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
